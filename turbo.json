{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "E2E",
        "PAYER_SECRET_KEY",
        "SUI_GRPC_URL",
        "FACILITATOR_URL",
        "PAY_TO",
        "ASSET",
        "AMOUNT"
      ]
    }
  }
}
