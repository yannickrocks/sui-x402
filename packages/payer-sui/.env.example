# Copy to .env (gitignored) and fill in. Never commit the real values.
# vitest does not read .env by itself:
#   set -a; source packages/payer-sui/.env; set +a

# Bech32 secret key of the testnet payer wallet, from
# `sui keytool export --key-identity <address>`. Ed25519 only.
PAYER_SECRET_KEY=

# Set to 1 to run test/e2e.test.ts, which spends real testnet USDC.
E2E=

# Sui testnet gRPC endpoint. Defaults to https://fullnode.testnet.sui.io:443
SUI_GRPC_URL=

# Seller the e2e test pays: any seller advertising the fixture's terms, e.g.
# examples/hono-server running locally.
X402_RESOURCE_URL=
