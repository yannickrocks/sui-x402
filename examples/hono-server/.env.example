# Copy to .env (gitignored) and adjust. The server variables below are not
# secrets — the seller never signs anything, so this side of x402 holds no key.
# The e2e section at the bottom does carry one: PAYER_SECRET_KEY.
# Neither the server nor vitest reads .env by itself — export the vars first:
#   set -a; source examples/hono-server/.env; set +a

# REQUIRED. Sui address that receives the payment. Must not be the payer's own
# address: a self-transfer credits nothing and the payer's pre-broadcast
# self-check refuses to sign it.
PAY_TO=

# Facilitator base URL. Defaults to http://localhost:4402 — the self-hosted
# instance from deploy/facilitator (PRD 8.16). The public testnet demo,
# https://sui-facilitator.onrender.com, is fine for a first run but is one
# person's Render instance, not a production dependency.
FACILITATOR_URL=

# Full coin struct tag, never a symbol. Defaults to testnet USDC:
# 0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
ASSET=

# Price in atomic units, as a string. Defaults to 10000 = 0.01 USDC at 6 decimals.
AMOUNT=

# sui:testnet (default) or sui:mainnet. Mainnet is refused at startup unless the
# code passes allowMainnet, which this example deliberately does not.
NETWORK=

# strict (default) settles before the handler runs; fast serves first and
# settles afterwards, so a failed settlement costs you the content, not the payer.
MODE=

# TCP port. Defaults to 8402.
PORT=

# --- test/e2e.test.ts only (M3.4) ---

# Set to 1 to run the live loop, which spends real testnet USDC.
E2E=

# Bech32 secret key of the funded testnet payer wallet (docs/BLOCKED.md #1).
# A real secret: never commit it, never paste it into a PR, an issue or a chat.
PAYER_SECRET_KEY=

# Sui testnet gRPC endpoint. Defaults to https://fullnode.testnet.sui.io:443
SUI_GRPC_URL=
