# Copy to .env.local (Next loads it; gitignored). Never commit real values.

# Sui address that receives payments (required).
PAY_TO=

# Facilitator base URL. Self-host per docs/facilitator-runbook.md; this
# project's testnet instance https://facilitator-production-1e79.up.railway.app
# works for trying it out.
FACILITATOR_URL=http://localhost:4402

# Price in atomic units (USDC has 6 decimals; 10000 = $0.01) and the coin type.
AMOUNT=10000
ASSET=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC

# sui:testnet (default) or sui:mainnet. Mainnet is refused at startup unless the
# code passes allowMainnet, which this example deliberately does not, and
# also needs a matching mainnet ASSET.
# NETWORK=sui:testnet
