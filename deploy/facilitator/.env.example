# Self-hosted facilitator — copy to .env (gitignored). Every variable is read
# by upstream/src/config.ts, routes.ts, rpc.ts, enoki.ts; nothing here is ours.

PORT=4402

# Comma-separated gRPC failover list, first = primary. Verification TRUSTS the
# node's answers (dry-run, balance changes, digest lookups), so only list
# endpoints you trust: Mysten's official fullnode plus your own node or a paid
# provider with Sui gRPC support. Replace the second entry before deploying.
SUI_TESTNET_RPC=https://fullnode.testnet.sui.io:443

# Per-call timeout before failing over to the next endpoint.
RPC_TIMEOUT_MS=20000

# Requests per IP per minute on /verify, /settle, /gas-station*.
RATE_LIMIT=120

# Mainnet stays OFF. Only a human flips this, after the hardening review —
# see docs/facilitator-runbook.md "Mainnet".
# ENABLE_MAINNET=1
# SUI_MAINNET_RPC=https://fullnode.mainnet.sui.io:443,https://SECOND-TRUSTED-MAINNET-GRPC:443

# Optional gas station (gasless payers). Leave unset for v1; the sponsor key
# pays gas only but is still a funded key — provision via platform secrets,
# never in this file.
# ENOKI_KEY=
# SPONSOR_DAILY_CAP=60
# SPONSOR_GLOBAL_DAILY_CAP=1000
